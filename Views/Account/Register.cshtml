@{
    ViewData["Title"] = "Driver Registration";
}

<style>
    .exclusive-auth-node {
        background: var(--surface-glass); border: 1px solid var(--surface-border);
        border-radius: 30px; padding: 40px; max-width: 500px; margin: 40px auto;
        backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);
        box-shadow: var(--shadow-neu); position: relative;
    }
    .exclusive-auth-node:hover { border-color: var(--accent-glow); }
    .auth-header h2 { font-weight: 800; font-size: 2rem; color: var(--text-main); }
    .auth-header p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 24px; }

    .input-wrapper-vip { position: relative; margin-bottom: 20px; }
    .input-wrapper-vip label { display: block; font-weight: 700; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 8px; }
    .input-container-inner { position: relative; display: flex; align-items: center; }
    .input-container-inner i { position: absolute; left: 18px; color: var(--text-muted); }
    
    .input-vip-hybrid {
        width: 100%; padding: 12px 16px 12px 54px; border: 1px solid var(--surface-border);
        border-radius: 14px; font-size: 0.95rem; background: rgba(255, 255, 255, 0.02);
        color: var(--text-main); box-shadow: var(--shadow-active); outline: none; transition: all 0.3s ease;
    }
    .input-vip-hybrid:focus { border-color: var(--accent-glow); background: var(--surface-glass); }
    .btn-cyber-submit { background: var(--accent-gradient); color: #ffffff; width: 100%; border: none; padding: 14px; border-radius: 14px; font-weight: 700; font-size: 1rem; margin-top: 12px; cursor: pointer; transition: all 0.3s ease; }
    .btn-cyber-submit:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(56, 189, 248, 0.4); }
    .auth-footer { margin-top: 24px; font-size: 0.9rem; color: var(--text-muted); text-align: center; }
    .auth-footer a { color: var(--accent-glow); text-decoration: none; font-weight: 600; }
</style>

<div class="exclusive-auth-node">
    <div class="auth-header text-center">
        <h2>Create Driver Account</h2>
        <p>Register your profile to access smart city parking spaces.</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center raw-mat-alert" style="border-radius: 12px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #f87171; font-size: 0.9rem; padding: 10px; margin-bottom: 20px;">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @ViewBag.Error
        </div>
    }

    <form asp-controller="Account" asp-action="Register" method="post">
        <div class="input-wrapper-vip">
            <label>Full Name</label>
            <div class="input-container-inner">
                <i class="fa-solid fa-user"></i>
                <input type="text" name="fullName" class="input-vip-hybrid" placeholder="Ali Khan" required />
            </div>
        </div>

        <div class="input-wrapper-vip">
            <label>Phone Number</label>
            <div class="input-container-inner">
                <i class="fa-solid fa-phone"></i>
                <input type="tel" name="phone" class="input-vip-hybrid" placeholder="03001234567" required />
            </div>
        </div>

        <div class="input-wrapper-vip">
            <label>Email Address</label>
            <div class="input-container-inner">
                <i class="fa-solid fa-envelope"></i>
                <input type="email" name="email" class="input-vip-hybrid" placeholder="driver@email.com" required />
            </div>
        </div>

        <div class="input-wrapper-vip">
            <label>Password</label>
            <div class="input-container-inner">
                <i class="fa-solid fa-lock"></i>
                <input type="password" name="password" class="input-vip-hybrid" placeholder="••••••••" required />
            </div>
        </div>

        <div class="input-wrapper-vip">
            <label>Confirm Password</label>
            <div class="input-container-inner">
                <i class="fa-solid fa-shield-halved"></i>
                <input type="password" name="confirmPassword" class="input-vip-hybrid" placeholder="••••••••" required />
            </div>
        </div>

        <button type="submit" class="btn-cyber-submit">Register Driver Profile</button>
    </form>

    <div class="auth-footer">
        Already have a profile? <a asp-controller="Account" asp-action="Login">Log In Here</a>
    </div>
</div>