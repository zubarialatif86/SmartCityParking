@{
    ViewData["Title"] = "SmartPark - 3D Smart Parking";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartPark | Futuristic Parking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        body {
            overflow-x: hidden;
            background: #0a0f1e;
        }
        #canvas-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.35;
            filter: blur(0.8px);
        }
        .dark-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.65);
            z-index: 1;
            pointer-events: none;
        }
        .content {
            position: relative;
            z-index: 15;
            min-height: 100vh;
        }
        .navbar-glass {
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(56,189,248,0.3);
            padding: 16px 32px;
        }
        .nav-link {
            color: #e2e8f0 !important;
            font-weight: 500;
            margin: 0 8px;
            transition: 0.2s;
        }
        .nav-link:hover { color: #38bdf8 !important; transform: translateY(-2px); }
        .hero-section { padding: 80px 0; text-align: center; }
        .hero-badge {
            background: rgba(56,189,248,0.2);
            border: 1px solid rgba(56,189,248,0.5);
            border-radius: 100px;
            display: inline-block;
            padding: 8px 20px;
            color: #38bdf8;
            font-weight: 500;
            margin-bottom: 24px;
        }
        .hero-title {
            font-size: 4rem;
            font-weight: 800;
            background: linear-gradient(135deg, #ffffff, #94a3f8);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 20px;
        }
        .hero-desc {
            color: #cbd5e1;
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto 40px;
        }
        .search-card {
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(16px);
            border-radius: 60px;
            padding: 12px 20px;
            display: inline-flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
            border: 1px solid rgba(56,189,248,0.4);
        }
        .search-card select, .search-card button {
            background: rgba(0,0,0,0.7);
            border: 1px solid rgba(56,189,248,0.4);
            padding: 12px 24px;
            border-radius: 40px;
            color: white;
            cursor: pointer;
        }
        .search-card button {
            background: #38bdf8;
            color: #0f172a;
            font-weight: bold;
            border: none;
        }
        .feature-card {
            background: rgba(0,0,0,0.55);
            backdrop-filter: blur(16px);
            border-radius: 28px;
            padding: 32px;
            transition: 0.3s;
            height: 100%;
            border: 1px solid rgba(56,189,248,0.25);
            color: white;
        }
        .feature-card:hover {
            transform: translateY(-8px);
            border-color: #38bdf8;
            background: rgba(0,0,0,0.7);
        }
        .admin-float {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: rgba(0,0,0,0.8);
            backdrop-filter: blur(12px);
            border-radius: 60px;
            padding: 12px 28px;
            color: #38bdf8;
            text-decoration: none;
            font-weight: 600;
            border: 1px solid #38bdf8;
            z-index: 100;
            transition: 0.3s;
        }
        .admin-float:hover {
            background: #38bdf8;
            color: #0f172a;
            transform: scale(1.05);
        }
        footer {
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(8px);
            padding: 20px;
            text-align: center;
            margin-top: 60px;
            color: #94a3b8;
        }
        @@media (max-width: 768px) {
            .hero-title { font-size: 2.5rem; }
            .search-card { flex-direction: column; width: 90%; margin: 0 auto; }
        }
    </style>
</head>
<body>
    <div id="canvas-bg"></div>
    <div class="dark-overlay"></div>
    <div class="content">
        <nav class="navbar-glass">
            <div class="container">
                <a class="navbar-brand fw-bold text-white" href="#"><i class="fas fa-parking text-info"></i> SmartPark</a>
                <div class="ms-auto">
                    <a href="/Account/Login" class="nav-link d-inline-block"><i class="fas fa-sign-in-alt"></i> Driver Login</a>
                    <a href="/Account/Register" class="nav-link d-inline-block"><i class="fas fa-user-plus"></i> Register</a>
                </div>
            </div>
        </nav>
        <div class="hero-section">
            <div class="hero-badge"><i class="fas fa-circle-check"></i> AI-Powered Smart Parking</div>
            <h1 class="hero-title">Next Generation<br><span class="gradient-text">Parking Ecosystem</span></h1>
            <p class="hero-desc">Real-time slot availability, QR-based entry, automated billing – all in one seamless platform.</p>
            <div class="search-card">
                <select><option>Select Zone</option><option>Blue Area</option><option>Saddar</option></select>
                <select><option>Vehicle Type</option><option>Car</option><option>Bike</option></select>
                <button onclick="location.href='/Account/Login'"><i class="fas fa-search"></i> Find Space</button>
            </div>
        </div>
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-md-4"><div class="feature-card text-center"><i class="fas fa-tower-broadcast fa-3x text-info mb-3"></i><h5>Live Telemetry</h5><p>Real-time occupancy tracking</p></div></div>
                <div class="col-md-4"><div class="feature-card text-center"><i class="fas fa-qrcode fa-3x text-info mb-3"></i><h5>QR Entry</h5><p>Ticketless access</p></div></div>
                <div class="col-md-4"><div class="feature-card text-center"><i class="fas fa-file-invoice-dollar fa-3x text-info mb-3"></i><h5>Auto Billing</h5><p>Pay exactly for time used</p></div></div>
            </div>
        </div>
        <footer><p>© 2025 SmartCity Parking – Futuristic Urban Mobility</p></footer>
    </div>
    <a href="/Account/AdminLogin" class="admin-float"><i class="fas fa-user-shield"></i> Admin Portal</a>

    <script>
        // Soft 3D Background - Low opacity, dark colors
        (function() {
            const container = document.getElementById('canvas-bg');
            if (!container) return;
            const scene = new THREE.Scene();
            scene.background = null;
            const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.z = 6;
            const renderer = new THREE.WebGLRenderer({ alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setClearColor(0x000000, 0);
            container.appendChild(renderer.domElement);
            
            const geometry = new THREE.TorusKnotGeometry(1.5, 0.4, 180, 32, 3, 4);
            const material = new THREE.MeshStandardMaterial({ color: 0x2c6e9e, emissive: 0x0a2a3a, roughness: 0.7 });
            const knot = new THREE.Mesh(geometry, material);
            scene.add(knot);
            
            const particleCount = 700;
            const particlesGeo = new THREE.BufferGeometry();
            const pos = new Float32Array(particleCount * 3);
            for (let i = 0; i < particleCount; i++) {
                pos[i*3] = (Math.random() - 0.5) * 35;
                pos[i*3+1] = (Math.random() - 0.5) * 25;
                pos[i*3+2] = (Math.random() - 0.5) * 25 - 8;
            }
            particlesGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
            const particlesMat = new THREE.PointsMaterial({ color: 0x4a8db7, size: 0.04, transparent: true, opacity: 0.3 });
            const particles = new THREE.Points(particlesGeo, particlesMat);
            scene.add(particles);
            
            const ambient = new THREE.AmbientLight(0x303060);
            scene.add(ambient);
            const light = new THREE.DirectionalLight(0x88aaff, 0.5);
            light.position.set(1, 2, 2);
            scene.add(light);
            
            function animate() {
                requestAnimationFrame(animate);
                knot.rotation.x += 0.004;
                knot.rotation.y += 0.007;
                particles.rotation.y += 0.003;
                renderer.render(scene, camera);
            }
            animate();
            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        })();
    </script>
</body>
</html>