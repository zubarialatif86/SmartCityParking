<!<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart City Parking</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-global: #05070f;
            --surface-glass: rgba(13, 18, 33, 0.45);
            --surface-border: rgba(255, 255, 255, 0.07);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-glow: #38bdf8;
            --accent-gradient: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
            --shadow-neu: -5px -5px 15px rgba(255,255,255,0.02), 5px 5px 15px rgba(0,0,0,0.4);
            --shadow-active: inset 3px 3px 7px rgba(0,0,0,0.4), inset -3px -3px 7px rgba(255,255,255,0.02);
        }

        [data-theme="light"] {
            --bg-global: #f1f5f9;
            --surface-glass: rgba(255, 255, 255, 0.55);
            --surface-border: rgba(15, 23, 42, 0.08);
            --text-main: #0f172a;
            --text-muted: #64748b;
            --accent-glow: #2563eb;
            --accent-gradient: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
            --shadow-neu: -6px -6px 14px rgba(255,255,255,0.7), 6px 6px 14px rgba(163,177,198,0.3);
            --shadow-active: inset 3px 3px 6px rgba(163,177,198,0.3), inset -3px -3px 6px rgba(255,255,255,0.7);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-global);
            color: var(--text-main);
            overflow-x: hidden;
            transition: background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            min-height: 100vh;
        }

        #three-canvas-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            pointer-events: none;
        }

        .vip-navbar {
            background-color: var(--surface-glass);
            backdrop-filter: blur(25px);
            border-bottom: 1px solid var(--surface-border);
            padding: 16px 0;
            box-shadow: var(--shadow-neu);
            z-index: 1000;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--text-main) !important;
        }

        .navbar-brand span {
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link-custom {
            color: var(--text-main) !important;
            font-weight: 600;
            font-size: 0.95rem;
            transition: color 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-link-custom:hover {
            color: var(--accent-glow) !important;
            background: transparent !important;
        }

        .theme-toggle-btn {
            background: var(--surface-glass);
            border: 1px solid var(--surface-border);
            box-shadow: var(--shadow-neu);
            color: var(--text-main);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-vip-primary {
            background: var(--accent-gradient);
            color: #ffffff !important;
            font-weight: 600;
            padding: 10px 24px;
            border-radius: 12px;
            border: none;
            transition: all 0.3s ease;
        }

        .main-container {
            margin-top: 120px;
            position: relative;
            z-index: 10;
        }

        footer {
            border-top: 1px solid var(--surface-border);
            padding: 20px 0;
            font-size: 0.85rem;
            color: var(--text-muted);
            text-align: center;
            margin-top: 40px;
        }

        /* 🚀 FIX: Links ko horizontal karne aur bullets hatane ke liye custom classes 🚀 */
        .navbar-nav {
            list-style: none !important;
            padding-left: 0 !important;
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
        }

        /* Mobile View Compatibility Fixes */
        @@media (max-width: 575.98px) {
            .navbar-collapse.show .navbar-nav {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 15px !important;
                padding-top: 15px;
            }
            .navbar-collapse.show .d-flex {
                flex-direction: column !important;
                align-items: flex-start !important;
                width: 100%;
                margin-top: 15px;
            }
        }
    </style>
</head>
<body>

    <div id="three-canvas-container"></div>

    <header>
        <nav class="navbar navbar-expand-sm vip-navbar fixed-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-square-p text-info me-2"></i>Smart<span>Parking</span>
                </a>

                <!-- Responsive Burger Icon Button -->
                <button class="navbar-toggler border-0 text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <!-- Collapsible Navbar Content Container -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="navbarContent">
                    <ul class="navbar-nav flex-grow-1 ms-4 gap-4">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Booking" asp-action="Search"><i class="fa-solid fa-magnifying-glass-location"></i> Find Parking</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Booking" asp-action="Create"><i class="fa-solid fa-circle-plus text-success"></i> Add New Slot</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-chart-line"></i> My Dashboard</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3 mt-2 mt-sm-0">
                        <button class="theme-toggle-btn" id="themeToggle" title="Toggle Theme">
                            <i class="fa-solid fa-moon" id="themeIcon"></i>
                        </button>
                        <a class="btn btn-vip-primary" asp-controller="Account" asp-action="Login">Driver Portal</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">&copy; 2026 - Smart City Smart Parking Dashboard. All Rights Reserved.</div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let scene, camera, renderer, starGeo, stars;
        let mouseX = 0, mouseY = 0;

        function init3D() {
            const container = document.getElementById('three-canvas-container');
            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 1, 1000);
            camera.position.z = 1;
            renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            container.appendChild(renderer.domElement);
            starGeo = new THREE.BufferGeometry();
            const starCount = 1200;
            const posArray = new Float32Array(starCount * 3);
            for(let i=0; i<starCount*3; i++) { posArray[i] = (Math.random() - 0.5) * 5; }
            starGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
            const material = new THREE.PointsMaterial({ size: 0.007, color: 0x38bdf8, transparent: true, opacity: 0.8 });
            stars = new THREE.Points(starGeo, material);
            scene.add(stars);
            document.addEventListener('mousemove', onMouseMove);
            window.addEventListener('resize', onWindowResize);
            animate();
        }

        function onMouseMove(event) { mouseX = (event.clientX - window.innerWidth / 2) * 0.0003; mouseY = (event.clientY - window.innerHeight / 2) * 0.0003; }
        function onWindowResize() { camera.aspect = window.innerWidth / window.innerHeight; camera.updateProjectionMatrix(); renderer.setSize(window.innerWidth, window.innerHeight); }
        function animate() { requestAnimationFrame(animate); camera.position.x += (mouseX - camera.position.x) * 0.05; camera.position.y += (-mouseY - camera.position.y) * 0.05; camera.lookAt(scene.position); stars.rotation.y += 0.0008; renderer.render(scene, camera); }

        const toggleBtn = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const htmlElement = document.documentElement;

        toggleBtn.addEventListener('click', () => {
            const currentTheme = htmlElement.getAttribute('data-theme');
            if (currentTheme === 'dark') { htmlElement.setAttribute('data-theme', 'light'); themeIcon.className = 'fa-solid fa-sun'; if(stars) stars.material.color.setHex(0x2563eb); }
            else { htmlElement.setAttribute('data-theme', 'dark'); themeIcon.className = 'fa-solid fa-moon'; if(stars) stars.material.color.setHex(0x38bdf8); }
        });
        init3D();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>