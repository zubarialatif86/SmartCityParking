@model SmartCityParking.Models.ParkingSlot
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Parking Slot";
}
<div class="glass-card">
    <h3><i class="fas fa-edit"></i> Edit Parking Slot</h3>
    <form asp-action="UpdateSlot" method="post">
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="mb-3">
            <label>Slot Number</label>
            <input name="SlotNumber" value="@Model.SlotNumber" class="form-control" required style="background:#1e1e1e; color:white; border:1px solid #38bdf8;" />
        </div>
        <div class="mb-3">
            <label>Location</label>
            <input name="Location" value="@Model.Location" class="form-control" style="background:#1e1e1e; color:white; border:1px solid #38bdf8;" />
        </div>
        <div class="mb-3">
            <label>Vehicle Type</label>
            <input name="VehicleType" value="@Model.VehicleType" class="form-control" style="background:#1e1e1e; color:white; border:1px solid #38bdf8;" />
        </div>
        <div class="mb-3">
            <label>Price per Hour (₹)</label>
            <input name="PricePerHour" type="number" step="0.5" value="@Model.PricePerHour" class="form-control" required style="background:#1e1e1e; color:white; border:1px solid #38bdf8;" />
        </div>
        <div class="form-check mb-3">
            <input type="checkbox" name="IsAvailable" value="true" @(Model.IsAvailable ? "checked" : "") />
            <label class="form-check-label">Available</label>
        </div>
        <button type="submit" class="btn-glass">Update Slot</button>
        <a href="/Admin/EditSlotList" class="btn-glass">Back</a>
    </form>
</div>