@model IEnumerable<SmartCityParking.Models.Booking>
@{
    Layout = "_AdminLayout"; ViewData["Title"] = "Bookings";
}
<div class="premium-card">
    <div class="d-flex justify-content-between align-items-center"><h3><i class="fas fa-calendar-check"></i> Bookings</h3><div><a href="/Admin/Bookings?status=All" class="btn-glass">All</a><a href="/Admin/Bookings?status=Active" class="btn-glass">Active</a><a href="/Admin/Bookings?status=Completed" class="btn-glass">Completed</a><a href="/Admin/Bookings?status=Cancelled" class="btn-glass">Cancelled</a></div></div>
    <form method="get" class="mt-3"><div class="input-group"><input type="text" name="search" class="form-control bg-dark text-white" placeholder="Search by vehicle..." value="@ViewBag.Search" /><button type="submit" class="btn-glass">Search</button></div></form>
    <div class="table-responsive mt-3"><table class="table table-dark glass-table"><thead><tr><th>Vehicle</th><th>Slot</th><th>Start</th><th>End</th><th>Amount</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var b in Model){
        <tr><td>@b.VehicleNumber</td><td>@b.ParkingSlot?.SlotNumber</td><td>@b.StartTime.ToString("g")</td><td>@b.EndTime.ToString("g")</td><td>₹@b.TotalAmount</td><td>@b.Status</td><td>@if(b.Status=="Active"){
            <form asp-action="CancelBooking" method="post"><input type="hidden" name="id" value="@b.Id" /><button class="btn btn-sm btn-danger">Cancel</button></form>
        }
    </td></tr>
}
</tbody></table></div></div>