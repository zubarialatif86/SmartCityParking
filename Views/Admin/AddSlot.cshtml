@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Parking Slot";
}
<div class="glass-card">
    <h3><i class="fas fa-plus"></i> Add New Parking Slot</h3>
    <form asp-action="AddSlot" method="post">
        <div class="mb-3">
            <label>Slot Number</label>
            <input name="SlotNumber" class="form-control" required style="background:#1e1e1e; color:white; border:1px solid #38bdf8;" />
        </div>
        <div class="mb-3">
            <label>Location</label>
            <input name="Location" class="form-control" style="background:#1e1e1e; color:white; border:1px solid #38bdf8;" />
        </div>
        <div class="mb-3">
            <label>Vehicle Type</label>
            <input name="VehicleType" class="form-control" value="Car" style="background:#1e1e1e; color:white; border:1px solid #38bdf8;" />
        </div>
        <div class="mb-3">
            <label>Price per Hour (₹)</label>
            <input name="PricePerHour" type="number" step="0.5" class="form-control" required style="background:#1e1e1e; color:white; border:1px solid #38bdf8;" />
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="IsAvailable" value="true" checked />
            <label class="form-check-label">Available</label>
        </div>
        <button type="submit" class="btn-glass">Save Slot</button>
        <a href="/Admin/Dashboard" class="btn-glass">Cancel</a>
    </form>
</div>